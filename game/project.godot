[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="viewmodel"
3d_render/layer_3="ui3d"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="zombie_hitbox"
3d_physics/layer_4="zombie_body"
3d_physics/layer_5="interactable"
3d_physics/layer_6="projectile"
3d_physics/layer_7="trigger"
3d_physics/layer_8="nav_obstacle"
3d_physics/layer_9="player_clip"

[navigation]

3d/default_cell_size=0.15
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=1

[importer_defaults]

scene={
"import_script/path": "res://core/art/post_import.gd",
"meshes/ensure_tangents": true,
"meshes/generate_lods": true,
"meshes/create_shadow_meshes": true,
"meshes/light_baking": 1,
"meshes/force_disable_compression": false,
"animation/import": true,
"animation/fps": 30
}
texture={
"compress/mode": 2,
"mipmaps/generate": true,
"detect_3d/compress_to": 1
}
