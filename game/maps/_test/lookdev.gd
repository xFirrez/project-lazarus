# Look-dev scene (Step 4B): a finished-quality slice of the Frozen Courtyard and a Sanatorium
# Lobby corner that sets the art bar (docs/STYLE_GUIDE.md). Geometry is generated by
# tools/lookdev/build_lookdev.gd; this script only animates it: the comms-ridge searchlight sweeps
# the yard, red beacons blink, lamp lanterns sway in the gusts, and the window glow flickers.
# Everything is driven by the shared clock time so peers see the same thing.
# Authority: local presentation (no gameplay state).
extends Node3D

const SWEEP_PERIOD: float = 14.0

var _t: float = 0.0
var _search: SpotLight3D = null
var _beacons: Array[Light3D] = []
var _lanterns: Array[Node3D] = []
var _spill: Array[OmniLight3D] = []


func _ready() -> void:
	_search = get_node_or_null(^"Lights/Searchlight") as SpotLight3D
	for n: Node in find_children("*Beacon*", "Light3D", true, false):
		_beacons.append(n as Light3D)
	for n: Node in find_children("Lantern", "Node3D", true, false):
		_lanterns.append(n as Node3D)
	for n: Node in find_children("WindowSpill_*", "OmniLight3D", true, false):
		_spill.append(n as OmniLight3D)


func _process(_delta: float) -> void:
	_t = Net.host_time()
	if _search != null:
		# Figure-eight sweep across the courtyard.
		var a: float = _t / SWEEP_PERIOD * TAU
		var aim: Vector3 = Vector3(sin(a) * 11.0, 0.0, 2.0 + sin(a * 2.0) * 6.0)
		_search.look_at(aim, Vector3.UP)
	var blink: bool = fmod(_t, 1.2) < 0.6
	for b: Light3D in _beacons:
		b.visible = blink
	for i: int in _lanterns.size():
		var l: Node3D = _lanterns[i]
		l.rotation.x = sin(_t * 1.9 + i) * 0.06 * (0.6 + 0.4 * sin(_t * 0.31))
		l.rotation.z = sin(_t * 1.3 + i * 2.0) * 0.04
	for i: int in _spill.size():
		_spill[i].light_energy = 1.6 + 0.12 * sin(_t * 7.0 + i * 3.1) * sin(_t * 1.7 + i)
