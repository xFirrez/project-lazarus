# Normalize text
* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.sh text eol=lf

# Large binary assets via Git LFS (ARCHITECTURE §2.3)
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
# PNGs are LFS except small addon icons and review screenshots, which stay as normal git blobs
*.png filter=lfs diff=lfs merge=lfs -text
game/addons/** -filter -diff -merge
docs/screenshots/**/*.png -filter -diff -merge -text
*.svg text
# Script-generated GLBs (tools/blender, Step 4) are small and regenerable: normal git blobs
# (the cloud sessions' git proxy cannot upload LFS objects). Hand-authored GLBs stay in LFS.
game/content/kits/**/*.glb -filter -diff -merge -text
game/content/props/**/*.glb -filter -diff -merge -text
game/content/characters/**/*.glb -filter -diff -merge -text
game/content/enemies/**/*.glb -filter -diff -merge -text
game/content/weapons/m1911/*.glb -filter -diff -merge -text

# Script-generated decal textures (tools/art/gen_decals.py, Step 13): normal git blobs
game/content/decals/*.png -filter -diff -merge -text
# Step 15: generated score audio and the open-license UI fonts are stored as plain git blobs
# (the cloud git proxy refuses LFS uploads).
game/content/audio/score/*.wav -filter -diff -merge -text
game/content/ui/fonts/*.ttf -filter -diff -merge -text
